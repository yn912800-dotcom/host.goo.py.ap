# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Platform admin bootstrap (first boot only) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- OAuth (optional; enable Google Login from Admin Settings) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- SMTP (optional, for email verification & password reset) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Platform ----
NODE_ENV=development
# Production runtime isolation. Required for Python/Node/PHP deployments in production.
# Railway should run the Control Plane; point this at a separate worker with containers/cgroups.
RUNTIME_WORKER_URL=
# Optional shared secret for an isolated runtime worker.
WORKER_SHARED_SECRET=
# Use object storage or a persistent volume in production; Railway local disk is ephemeral.
DATA_DIR=.data/servers
